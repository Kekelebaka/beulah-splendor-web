{
  // Beulah Splendor — Cloudflare Workers configuration
  // Managed by vinext. Do not edit the Worker entry point; vinext generates it.
  "name": "beulah-splendor-web",
  "main": ".vinext/worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beulah-splendor-staging",
      "database_id": "placeholder-replace-with-real-id"
    }
  ],

  // Environment variables (non-secret)
  "vars": {
    "TURNSTILE_STATUS": "NOT_CONFIGURED"
  },

  // Assets generated by vinext
  "assets": {
    "binding": "ASSETS",
    "directory": ".vinext/client"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
