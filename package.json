{
  "name": "beulah-splendor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npx wrangler d1 execute beulah-splendor-db --remote --file=./src/lib/db/migrations/0001_init.sql",
    "db:migrate:local": "npx wrangler d1 execute beulah-splendor-db --local --file=./src/lib/db/migrations/0001_init.sql",
    "db:seed": "npx wrangler d1 execute beulah-splendor-db --remote --file=./src/lib/db/seed.sql",
    "db:seed:local": "npx wrangler d1 execute beulah-splendor-db --local --file=./src/lib/db/seed.sql",
    "db:migrate:staging": "npx wrangler d1 execute beulah-splendor-staging --remote --file=./src/lib/db/migrations/0001_init.sql --env staging",
    "db:seed:staging": "npx wrangler d1 execute beulah-splendor-staging --remote --file=./src/lib/db/seed.sql --env staging",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:staging": "vinext-cloudflare deploy --config dist/server/wrangler.json --env staging",
    "deploy:production": "vinext-cloudflare deploy --config dist/server/wrangler.json --env production"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "next": "^15.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
