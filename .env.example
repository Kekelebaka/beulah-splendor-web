# Beulah Splendor — Environment Variables
# Copy to .env.local for local development

# Cloudflare Turnstile (replace with real keys from Cloudflare Dashboard)
TURNSTILE_SECRET_KEY=0x4AAAAAAA-placeholder-secret

# Public Turnstile site key (used in client-side widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA-placeholder

# WhatsApp number for booking handoff (international format, no +)
NEXT_PUBLIC_WHATSAPP_PHONE=27000000000

# Cloudflare Web Analytics token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Site URL
NEXT_PUBLIC_SITE_URL=https://beulahsplendor.co.za
